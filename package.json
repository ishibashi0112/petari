{
  "name": "tazuna",
  "version": "0.15.0",
  "description": "tazuna — pack your codebase for AI chat, then apply its patches safely (zero dependencies; formerly petari and slnmix)",
  "keywords": [
    "cli",
    "ai",
    "chat",
    "copilot",
    "patch",
    "diff",
    "apply",
    "repomix",
    "pack",
    "vb.net",
    "visual-studio",
    "sln",
    "vbproj"
  ],
  "license": "MIT",
  "author": "Yuki Sakakibara",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ishibashi0112/tazuna.git"
  },
  "homepage": "https://github.com/ishibashi0112/tazuna#readme",
  "bugs": {
    "url": "https://github.com/ishibashi0112/tazuna/issues"
  },
  "type": "module",
  "bin": {
    "tazuna": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "node src/cli.ts",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "gen:sjis": "node scripts/generate-sjis-table.ts"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
